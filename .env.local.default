ISDEV = true

# Audio Service Configuration
VITE_VAD_THRESHOLD=0.8
VITE_AUDIO_VOLUME=1.0
VITE_VAD_ENABLED=true

# TTS Service Configuration
VITE_TTS_VOICE=en_US-hfc_female-medium
VITE_TTS_SPEED=1.0
VITE_TTS_PITCH=1.0
VITE_TTS_VOLUME=1.0
VITE_TTS_MODE=cloud
VITE_TTS_API_KEY=
VITE_TTS_URL=https://api.openai.com/v1/audio/speech
VITE_TTS_MODEL=tts-1
VITE_TTS_STABILITY=0.5
VITE_TTS_SIMILARITY_BOOST=0.8

# STT Service Configuration
VITE_STT_LANGUAGE=en-US
VITE_STT_CONTINUOUS=true
VITE_STT_REMOTE=true
VITE_STT_API_KEY=

# LLM Service Configuration
# 'api' = hosted /api/chat function (default), 'script' = directed responses only
VITE_LLM_PROVIDER=api
VITE_CHAT_API_URL=/api/chat

# Server-side only (no VITE_ prefix, never bundled). Set these in Vercel project env vars too.
# Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Rahul's cloned voice (server-side only, set in Vercel too). VITE_TTS_MODE=cloud uses it and falls back
# to the browser voice when these aren't set.
INWORLD_API_KEY=
INWORLD_VOICE_ID=
INWORLD_MODEL=inworld-tts-2

# Audio-driven lipsync model (~146MB). Defaults to /models/audio2exp-int8-matmul.onnx for local dev;
# point this at external hosting (e.g. a Hugging Face repo) in production.
VITE_A2E_MODEL_URL=

